# ==========================================
# FastAPI & Python Core
# ==========================================
# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
pythonenv*/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.[a-zA-Z]*
!.env.example
.flaskenv
secrets.toml

# ==========================================
# Databases & Local Storage
# ==========================================
# SQLite databases (commonly used for local FastAPI development)
*.db
*.sqlite
*.sqlite3

# Local storage / uploaded user files
storage/
uploads/
media/

# ==========================================
# Testing & Coverage
# ==========================================
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ==========================================
# Package Managers & Build Logs
# ==========================================
# Build directories
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Poetry, Pipenv, and uv logs (Keep the actual lock files, ignore logs)
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# IDEs and Editors
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/

# Mac system files
.DS_Store
